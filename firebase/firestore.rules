rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomHost(roomCode) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostId == request.auth.uid;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public room documents
    match /rooms/{roomCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        // Allow players to update their own sub-fields in players map
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
      );
      allow delete: if isRoomHost(roomCode);

      // Private player hands/tickets subcollection:
      // STRICT PRIVACY: User can only read and write their OWN private state!
      match /private/{playerId} {
        allow read, write: if isOwner(playerId);
      }
    }
  }
}
